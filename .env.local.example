# ============================================================
# QG Joga Junto: variáveis de ambiente
# Copie para .env.local e preencha. Sem o Firebase preenchido,
# `npm run dev` abre o modo demonstração com dados fictícios.
# ============================================================

# --- Quem é administrador (e-mails separados por vírgula) ---
# A primeira pessoa entra por aqui. As demais são liberadas na tela Equipe.
ADMIN_EMAILS=

# --- Firebase Client (públicas, usadas no navegador) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (segredo, usadas apenas no servidor) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Entre aspas, numa linha só, com \n literais
FIREBASE_PRIVATE_KEY=

# --- IA: Gemini (segredo, usada apenas no servidor) ---
# Crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: outro modelo com cota gratuita (padrão: gemini-3.8-flash)
GEMINI_MODEL=
